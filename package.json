{
  "name": "grand-brawl",
  "version": "1.0.0",
  "description": "GRAND BRAWL - a 3D anime pirate platform fighting game (Three.js + authoritative Node.js multiplayer server)",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/build.js && node server/server.js",
    "serve": "node server/server.js",
    "test": "node --test tests/*.test.js tests/visual/*.test.js tests/audio/*.test.js",
    "test:e2e": "node scripts/build.js && node tests/e2e/run-all.cjs",
    "dev": "node scripts/build.js --dev && node server/server.js"
  },
  "dependencies": {
    "three": "0.170.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "esbuild": "0.24.0"
  },
  "engines": {
    "node": ">=18"
  }
}
